PORT=5000
NODE_ENV=development

# Database
# Provide MongoDB URI (e.g., mongodb://localhost:27017/smart_campus or MongoDB Atlas)
# If MongoDB is not running or connection fails, the system automatically runs on high-reliability embedded persistent storage.
MONGO_URI=mongodb://127.0.0.1:27017/smart_campus

# Authentication
JWT_SECRET=smart_campus_super_secret_jwt_key_2026_xyz!
JWT_EXPIRES_IN=7d

# Campus Geolocation Settings
# Default: Engineering College Campus coordinates
CAMPUS_NAME=Greenwood Institute of Technology
CAMPUS_LATITUDE=12.9716
CAMPUS_LONGITUDE=77.5946
CAMPUS_RADIUS_METERS=1500

# Google Gemini AI Integration (Optional - rule-based fallback active if empty)
GEMINI_API_KEY=

# Cloudinary Integration (Optional - local upload storage fallback active if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
